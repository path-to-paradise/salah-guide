# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real values.

# Google Analytics 4 Measurement ID (Admin -> Data Streams -> your web stream).
# Looks like G-XXXXXXXXXX. Leave unset to disable analytics entirely
# (e.g. in local dev) — the site works fine without it.
VITE_GA_MEASUREMENT_ID=
